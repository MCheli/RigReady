{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/core/**/*.ts",
    "src/platform/**/*.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "src/features/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/legacy", "src/features/**/renderer/**", "src/features/*/index.ts"]
}
