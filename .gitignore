# Dependencies
node_modules/

# Build output
dist/
release/
_site/

# Test coverage, and the unit test reports of one shard (npm run test:coverage:shard)
coverage/
.vitest/

# Python environment and the ViGEm client library (generated by setup:python)
resources/python/
resources/vigem/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Temporary files
*.tmp
*.temp
nul

# Test results
test-results/
playwright-report/
.playwright/

# Run artifacts. Scenario screenshots are tracked: they are requirement evidence.
artifacts/*
!artifacts/screens/

# Fixtures are recordings: nothing in them is ignored (a recorded dcs.log is evidence, not noise).
!fixtures/**
.claude/worktrees/
.claude/settings.local.json
