{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "preserve"
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.vue",
    "src/features/**/renderer/**/*.ts",
    "src/features/**/renderer/**/*.vue",
    "src/features/*/index.ts"
  ],
  "exclude": ["node_modules", "dist", "src/legacy"]
}
