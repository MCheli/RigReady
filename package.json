{
  "name": "rigready",
  "version": "2.0.0-dev.0",
  "description": "Verifies a sim rig is ready, fixes what is not, and launches the game",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:scenario": "node scripts/dev-scenario.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ledger:check": "tsx scripts/ledger-check.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run ledger:check",
    "test:e2e": "npm run build && playwright test",
    "rig:record": "tsx scripts/rig-record.ts",
    "rig:smoke": "vitest run --config vitest.rig.config.ts",
    "rig:smoke:apply": "cross-env RIGREADY_RIG_APPLY=1 vitest run --config vitest.rig.config.ts",
    "setup:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-python.ps1",
    "pack": "npm run build && node scripts/check-sidecar.mjs && electron-builder --dir",
    "smoke:packaged": "npm run pack && playwright test --config playwright.packaged.config.ts",
    "dist": "npm run build && node scripts/check-sidecar.mjs && electron-builder --win --publish never",
    "prepare": "husky",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,mjs}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCheli/rigready.git"
  },
  "keywords": [
    "simulation",
    "flight-sim",
    "sim-racing",
    "dcs",
    "hotas"
  ],
  "author": {
    "name": "Mark Cheli",
    "url": "https://www.markcheli.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MCheli/rigready/issues"
  },
  "homepage": "https://rigready.io",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "io.rigready.app",
    "productName": "RigReady",
    "copyright": "Copyright (c) 2026 Mark Cheli",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RigReady",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "python",
        "to": "sidecar",
        "filter": [
          "*.py"
        ]
      }
    ]
  },
  "dependencies": {
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fengari": "^0.1.5",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.2",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.3.0",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12",
    "vuetify": "^4.2.3",
    "zod": "^4.6.5"
  }
}
